# Google Cloud Console OAuth 2.0 Credentials (Desktop App)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------------------------------------------------------------------------
# Local AI engine (leave unset for auto-discovery)
# ---------------------------------------------------------------------------
# Zmail probes, in order: this URL -> http://127.0.0.1:8080 (LU / llama.cpp)
# -> http://127.0.0.1:11434 (Ollama). Set this to pin one endpoint.
# ZMAIL_AI_BASE_URL=http://127.0.0.1:8080

# Leave unset to auto-read the loaded model id from /v1/models.
# Set this if your server enforces a specific alias.
# ZMAIL_AI_MODEL=qwen3.5-9b

# Embedding model name as the local server knows it.
ZMAIL_EMBEDDING_MODEL=nomic-embed-text
